#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	   
	    int arr[n];
	    for(int i=0;i<n;i++){
	        cin>>arr[i];
	    }
	    int maxi=0;
	   for(int i=0;i<n;i++){
	        maxi=max(maxi,arr[i]);
	    }
	    for(int i=0;i<n;i++){
	     for(int j=i+1;j<n;j++){
	        if(arr[j]>=arr[i]){
	            int sum=arr[i]+arr[j];
	             maxi =max(maxi,sum);
	        }
	     }
	    }
	  cout<<maxi<<endl; 
	}
return 0;
}
