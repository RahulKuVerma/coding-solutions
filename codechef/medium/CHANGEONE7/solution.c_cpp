#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int N;
    cin>>N;
    int arr[N];
    for(int i=0;i<N;i++){
        cin>>arr[i];
    }
      if(N==2){
        cout<< 0<<endl;
        continue;
    }
    int ma,mi,ma2,mi2;
    ma=arr[0];
    mi=arr[0];
    for(int i=0;i<N;i++){
        if(ma<arr[i]){
            ma=arr[i];
        }
        if(mi>arr[i]){
            mi=arr[i];
        }
    }
    ma2 = INT_MIN;
    mi2 = INT_MAX;
        for (int i = 0; i < N; i++) {
            if (arr[i] != ma) ma2 = max(ma2, arr[i]);
            if (arr[i] != mi) mi2 = min(mi2, arr[i]);
        }
  
    int fin= ma2-mi;
    int fin2 = ma-mi2;
    int res = std::min(fin,fin2);
    cout<<res<<endl;
}
return 0;
}
