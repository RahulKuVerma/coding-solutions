#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	
	int t;
	cin>>t;
	while(t--){
	    int a,b,p,q,r;
	    cin>>a>>b>>p>>q>>r;
	    int costdig=0;
	    costdig= min(a,b)*r+(a-min(a,b))*p+(b-min(a,b))*q;
	    int costru=0;
	    int stepr=0;
	    if((a%2)!=0){
	        stepr=(a/2)+1;
	    }
	    else{
	        stepr=a/2;
	    }
	    int stepu=0;
	    if((b%2)!=0){
	        stepu=(b/2)+1;
	    }
	    else{
	        stepu=b/2;
	    }
	    costru=stepr*p+stepu*q;
	    int costfinal = min(costru,costdig);
	    cout<<costfinal<<endl;
	}
return 0;
}
