#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int N;
    cin>>N;
    vector<int>arr(N);
    for(int i=0;i<N;i++){
        cin>>arr[i];
    }
      if(N==2){
        cout<< 0<<endl;
        continue;
    }
    
     sort(arr.begin(), arr.end());

        int mi = arr[0];
        int ma = arr[N-1];
        int mi2 = arr[1];       
        int ma2 = arr[N-2];     
    
    int fin= ma2-mi;
    int fin2 = ma-mi2;
    int res = std::min(fin,fin2);
    cout<<res<<endl;
}
return 0;
}
