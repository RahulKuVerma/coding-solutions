#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        string S;
        cin >> S;

        vector<int> mark;

        for (int i = 0; i < N; i++) {
            if (S[i] == '1')
                mark.push_back(i + 1);
        }

        sort(mark.begin(), mark.end(), greater<int>());

        int res = 0;
        int i = 0;

        while (i < mark.size()) {
            res++;                  
            int pos = mark[i];      

            i++;

            while (i < mark.size() && pos - mark[i] <= K) {
                i++;                
            }
        }

        cout << res << endl;
    }

    return 0;
}