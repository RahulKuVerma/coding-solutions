#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int N,K;
    cin>>N>>K;
    
    vector<int>arr(N);
    
    for(int i=0;i<N;i++){
        cin>>arr[i];
    }
    
    sort(arr.begin(),arr.end(),greater<int>());
    
    int sum =0;
    
        for(int i=0;i<N;i++){
        sum=sum+arr[i];
        K--;
        if(K==0){
            break;
        }
    }
    
    cout<<sum<<endl;
    
}

return 0;
}
