#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    int arr[n];
	    for(int i=0;i<n;i++){
	        cin>>arr[i];
	    }
	    int count=0;
	    bool flag=true;
	    for(int i=0;i<n;i++){
	        if(arr[i]<=k){
	            k= k-arr[i];
	        count++;
	            
	        }
	       else if(flag){
	            count++;
	            flag = false;
	        }
	        else{
	            break;
	        }
	    }
	    cout<<count<<endl;
	}
return 0;
}
