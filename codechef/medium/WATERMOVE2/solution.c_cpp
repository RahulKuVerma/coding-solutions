#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int N,K;
    cin>>N>>K;
    
    vector<int>arr(N);
    
    for(int i=0;i<N;i++){
        cin>>arr[i];
    }
    
    sort(arr.begin(),arr.end(),greater<int>());
    
    
    long long result = arr[0];
        for (int i = 1; i <= K && i < N; i++) {
            result += arr[i];   
        }
   
    cout<<result<<endl;
    
}

return 0;
}
