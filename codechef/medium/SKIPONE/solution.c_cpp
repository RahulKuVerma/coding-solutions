#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    int arr[n];
	    for(int i=0;i<n;i++){
	        cin>>arr[i];
	    }
	    int sum=0;
	    int count=0;
	    bool flag=true;
	    for(int i=0;i<n;i++){
	        if(arr[i]<=k){
	        sum=sum+arr[i];
	        count++;}
	        if(arr[i]>=k || sum>=k){
	            count++;
	            flag = false;
	        }
	        if(sum>=k && flag ==false){
	            break;
	        }
	    }
	    cout<<count<<endl;
	}
return 0;
}
