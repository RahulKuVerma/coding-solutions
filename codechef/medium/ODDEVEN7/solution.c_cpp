#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int arr[n];
	    int even =0;
	    int odd= 0;
	    for(int  i=0;i<n;i++){
	        cin>>arr[i];
	    }
	     for(int  i=0;i<n;i++){
	        if(arr[i]%2==0){
	            even++;
	        }
	        else{
	            odd++;
	        }
	    }
	    int extra=0;
	    if(even!=odd){
	        extra=1;
	    }
	    int subset;
	    subset= 2*min(even,odd)+extra;
	    cout<<subset<<endl;
	}
return 0;
}
